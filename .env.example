# ClarifySign Environment Configuration
# Optional: HuggingFace token for gated models (e.g. IndicTrans2)
HF_TOKEN=

# Private, Git-ignored root for user-authorized datasets and JSONL manifests.
# Never set this to a repository directory and never commit the resolved path.
CLARIFYSIGN_DATA_ROOT=
# Required only after a specific ISL dictionary source receives legal approval.
CLARIFYSIGN_ISL_DICTIONARY_URL=
CLARIFYSIGN_ISL_DICTIONARY_LICENSE=

# Model settings
MODEL_PATH=models/isl_bilstm.pt
LABELS_PATH=models/labels.json
DEVICE=auto

# Clarification Policy Hyperparameters
CONFIDENCE_THRESHOLD=0.78
MARGIN_THRESHOLD=0.20
ENTROPY_THRESHOLD=1.25
UTILITY_THRESHOLD=0.05
ALPHA_CONTEXT=0.30
BETA_ANSWERABILITY=0.15
LAMBDA_COST=0.18

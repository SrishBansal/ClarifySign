# ClarifySign Backend Environment Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Device selection: auto | cpu | cuda | mps
DEVICE=auto

# Model & Assets paths (defaults to ../models/...)
MODELS_DIR=../models
MODEL_PATH=../models/isl_bilstm.pt
LABELS_PATH=../models/labels.json
HOLISTIC_TASK_PATH=../models/holistic_landmarker.task

# Uncertainty & Dialogue thresholds
CONFIDENCE_THRESHOLD=0.78
MARGIN_THRESHOLD=0.20
ENTROPY_THRESHOLD=1.25
UTILITY_THRESHOLD=0.05

# EIG Hyperparameters
ALPHA_CONTEXT=0.30
BETA_ANSWERABILITY=0.15
LAMBDA_COST=0.18
RHO0=0.95
TEMPERATURE=1.0
DIALOGUE_TIMEOUT_SECONDS=300
